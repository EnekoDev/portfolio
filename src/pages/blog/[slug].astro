---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../libs/posts";
import { Post } from "../../model/post";
import type { PostData } from "../../model/types";

export async function getStaticPaths() {
    const postData = await getPosts();
    if (postData.success && postData.data && Array.isArray(postData.data)) {
        return postData.data.map((post:PostData) => ({
            params: { slug: post.slug },
            props: { post }
        }));
    }
    return [];
}

const { post } = Astro.props;
const content = new Post(
    post.id,
    post.date.substring(0, 10),
    post.status === "publish",
    post.slug ?? "",
    post.title.rendered ?? "",
    post.content.rendered ?? "",
    post.excerpt.rendered ?? ""
);
---

<Layout>
    <section>
        <div>
            <article id={content.slug}>
                <h3>{content.title}</h3>
                <h4>{content.date}</h4>
                <p set:html={content.content} />
            </article>
        </div>
    </section>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import CustomButton from '../components/CustomButton.astro';

---

<Layout>
	<main>
		<section class="welcome-and-contact">
			<h2>Hi! I'm Eneko</h2>
			<h3>Web Developer From Bilbao, Spain</h3>
			<h3>I'm open to freelance work and collaborations</h3>
			<div class="contact-buttons">
				<CustomButton title='Contact' icon='/img/mail.svg' iconAlt='linkedin-logo' url='mailto:hello@enekolabarria.dev' />
				<CustomButton title='Linkedin' icon='/img/linkedin.svg' iconAlt='linkedin-logo' url='https://www.linkedin.com/in/eneko-olabarria-se%C3%B1oran-8b8b8015b/'/>
			</div>
		</section>
		<section class="about-me">
            <p>My name is Eneko Olabarria, I'm a web developer specialized in WordPress ecosystem. I build accesible and high-performance websites using PHP and JavaScript. I'm also pasionate about both Linux and FOSS.</p>
            <p>This is my tiny corner of the internet where I display my proyects and adventures in the world of software development.</p>
            <p>Get in touch with me for any question or work proposal you have, and don't forget to check out both my <a href="https://github.com/EnekoDev" target="_blank" class="about-me-link">GitHub</a> and <a href="https://www.linkedin.com/in/eneko-olabarria-se%C3%B1oran-8b8b8015b/" target="_blank" class="about-me-link">LinkedIn</a> pages.</p>
		</section>
	</main>
</Layout>

<style>
	.welcome-and-contact {
		padding-top: 1.5vh;
	}
	
	.contact-buttons {
		display: flex;
		gap: 20px;
	}

	.about-me {
		text-align: justify;
	}

	.about-me-link {
		color: #FFF
	}

	.welcome-and-contact, .proyects, .about-me {
		border-bottom: 1px solid gold;
		padding: 2vh 0;
	}
</style>
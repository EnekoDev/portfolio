---
import CustomButton from "../components/CustomButton.astro"

const date = new Date()
const year = date.getFullYear()
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Eneko Olabarria</title>
	</head>
	<body>
		<header class="site-head">
			<section class="site-title">
				<a href="/">Eneko Olabarria</a>
				
				<nav class="welcome-nav-bar">
					<a href="/experience">Experience</a>
					<a href="/projects">Projects</a>
					<a href="/blog">Blog</a>
				</nav>
			</section>
		</header>
		<slot />
		<footer class="footer">
			<section class="footer-copyright">
				<h4>&copy;{year} Eneko Olabarria. See you space cowboy.</h4>
				<h4>Checkout this projects repository:</h4>
				<CustomButton title='Repository' icon='/img/git.svg' iconAlt='Git logo' url='https://github.com/EnekoDev/portfolio'/>
			</section>
			<section class="footer-contact">
				<CustomButton title='Contact' icon='/img/mail.svg' iconAlt='linkedin-logo' url='mailto:hello@enekolabarria.dev' />
			</section>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--font-color: #FFF;
		--page-background-1: #61629E;
		--page-background-2: #9E9D61;
		--content-background: #ADADAD;
	}
	html {
		margin: 0;
		padding: 0;
		font-family: monospace, Arial, Helvetica, sans-serif;
		background: linear-gradient(var(--page-background-1) 0% 50%, var(--page-background-2) 100%);
		background-attachment: fixed;
		color: var(--font-color);
		scroll-behavior: smooth;
	}
	body {
		margin: 5vh 30vw 5vh 30vw;
	}

	@media (max-width: 1080px) {
		body {
			margin: 5vh 10vw 5vh 10vw;
		}
	}
</style>

<style>
	.site-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-title > a {
		text-decoration: none;
		color: var(--font-color);
		font-size: xx-large;
		font-weight: 700;
	}

	.site-title > a:hover {
		color: gold;
	}

	.welcome-nav-bar {
		border-radius: 12px;
		background-color: var(--content-background);
		display: flex;
		align-items: center;
		gap: 3vw;
		font-size: medium;
		font-weight: 700;
		margin-left: 3vw;
		padding: 1vh 3vw;
		width: fit-content;
	}

	.welcome-nav-bar > a, .welcome-nav-bar > a:visited {
		color: var(--font-color);
		text-decoration: none;
		white-space: nowrap;
	}
	.welcome-nav-bar > a:hover, .welcome-nav-bar > a:active, .welcome-nav-bar > a:focus {
		color: gold;
	}

	.footer {
		margin: 1vh 0vw 3vh 0vw;
		display: flex;
		justify-content: space-between;
		align-items: end;
	}

	@media (max-width: 1080px) {
		.site-title {
			flex-direction: column;
		}

		.welcome-nav-bar {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			margin: 2vw 0;
			width:50%;
		}
	}
</style>
---
import { getPosts } from "../libs/posts"
import { Post } from "../model/post";
import type { PostData } from "../model/types";

const posts:Post[] = [];
const postData = await getPosts();
if (postData.success && postData.data && Array.isArray(postData.data)) {
    postData.data.forEach((item:PostData) => {
        const post = new Post(
            item.id,
            item.date.substring(0, 10),
            item.status === "publish",
            item.slug ?? "",
            item.title.rendered ?? "",
            item.content.rendered ?? "",
            item.excerpt.rendered ?? ""
        );
        if (post.status) {
            posts.push(post);
        }
    });
}
---

<section>
    <div>
        {posts.length > 0 ?
            posts.map(post => (
                <article id={post.slug}>
                    <h3>{post.title}</h3>
                    <h4>{post.date}</h4>
                    <p set:html={post.excerpt} />
                    <a href={`/blog/${post.slug}`}>Read full article</a>
                </article>
            ))
        :
            <article>
                <h3>Coming soon...</h3>
            </article>
        }
    </div>
</section>
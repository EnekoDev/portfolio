---
interface Props {
    title: string,
    link: string,
    description: Array<string>
}
const { title, link, description }:Props = Astro.props
---

<div class="card-body">
    <div class="card-title">
        <h3><a href={link}>{title}</a></h3>
    </div>
    <div class="card-description">
        <ul>
            {description.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
    </div>
</div>
<br>

<style>
    .card-body {
        padding: 1vh 0vw 1vh 0vw;
        display: flex;
        justify-content: space-around;
    }

    .card-title, .card-description {
        flex: 1; 
        margin: 0 1vw;
    }
    
    .card-title{
        text-align: left;
    }

    .card-description {
        text-align: justify;
        li {
            padding-bottom: 1vh;
        }
    }

    @media (max-width: 1080px) {
        .card-body {
            display: block;
        }
        .card-description ul {
            padding: 1vh 0vw;
        }

        .card-description li {
            padding-bottom: 1vh;
        }
    }
</style>